{
  "info": {
    "name": "Stock API",
    "description": "Coleção da Stock API (NestJS + Prisma + PostgreSQL). Execute primeiro 'Autenticação > Login': o token é salvo automaticamente na variável {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productId",
      "value": "4ff85043-58be-4172-8ec2-709804e347bb"
    },
    {
      "key": "unitId",
      "value": "223c142c-48df-4850-99e9-de89c084f9ac"
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Retorna access_token (JWT). Usuários do seed: admin@stock.local / Admin123!, gerente@stock.local / Gerente123!, atendente@stock.local / Atendente123!",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@stock.local\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Login retorna 201', () => pm.response.to.have.status(201));",
                  "if (json.access_token) { pm.collectionVariables.set('token', json.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (gerente)",
